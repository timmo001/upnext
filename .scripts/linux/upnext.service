[Unit]
Description=upnext media feed daemon
Documentation=https://github.com/timmo001/upnext
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=%t
ExecStart=/usr/bin/upnext serve
# The Effect runtime exits 130 when systemd stops it.
SuccessExitStatus=130
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
