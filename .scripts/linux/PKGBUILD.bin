#!/bin/sh
# Maintainer: Aidan Timson (Timmo) <aidan@timmo.dev>
pkgname=upnext-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Twitch live channels, YouTube uploads and a watch-later queue in one feed (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/timmo001/upnext"
license=('Apache-2.0')
install=upnext.install
depends=('glibc')
provides=('upnext' 'twitch-notifications')
conflicts=('upnext' 'upnext-git' 'twitch-notifications' 'twitch-notifications-git')
replaces=('twitch-notifications')
options=('!strip')
source=('upnext.bash' 'upnext.fish' '_upnext' 'upnext.service' 'upnext.svg' 'LICENSE')
source_x86_64=("upnext-${pkgver}-linux-${CARCH}.tar.gz::$url/releases/download/${pkgver}/upnext-${pkgver}-linux-${CARCH}.tar.gz")
source_aarch64=("upnext-${pkgver}-linux-${CARCH}.tar.gz::$url/releases/download/${pkgver}/upnext-${pkgver}-linux-${CARCH}.tar.gz")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 upnext "$pkgdir/usr/bin/upnext"
  install -Dm644 upnext.service "$pkgdir/usr/lib/systemd/user/upnext.service"
  install -Dm644 upnext.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/upnext.svg"
  install -Dm644 upnext.bash "$pkgdir/usr/share/bash-completion/completions/upnext"
  install -Dm644 upnext.fish "$pkgdir/usr/share/fish/vendor_completions.d/upnext.fish"
  install -Dm644 _upnext "$pkgdir/usr/share/zsh/site-functions/_upnext"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
